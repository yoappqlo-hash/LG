rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'yoappqlo@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admins Whitelist Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Servers Collection
    match /servers/{serverId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serverId);
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(announcementId);
    }

    // Runbooks Documentation Collection
    match /runbooks/{runbookId} {
      allow read, write: if isAdmin() && isValidId(runbookId);
    }

    // System Configuration Collection
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }
  }
}
